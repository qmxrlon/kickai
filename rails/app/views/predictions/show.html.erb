<% content_for :title, "Vorhersage: #{@match.title}" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <div>
    <%= link_to "← Zurück zum Spiel", match_path(@match), class: "text-sm text-gray-400 hover:text-white" %>
    <h1 class="mt-3 text-2xl font-bold text-white"><%= @match.title %></h1>
    <p class="text-sm text-gray-500 mt-1">
      <%= @match.league.name %> · <%= @match.scheduled_at.strftime("%d.%m.%Y, %H:%M Uhr") %> · Modell v<%= @prediction.model_version %>
    </p>
  </div>

  <%= render "predictions/prediction_full", prediction: @prediction, match: @match %>

  <div class="rounded-2xl bg-gray-900 border border-gray-800 p-5">
    <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-3">Kelly-Rechner</h3>
    <%= form_with url: prediction_path(@prediction), method: :get, class: "flex flex-wrap items-end gap-3" do %>
      <label class="text-sm text-gray-400">
        Quote für „<%= { home: "Heimsieg", draw: "Unentschieden", away: "Auswärtssieg" }[@prediction.top_outcome] %>“
        <input type="number" name="odds" step="0.01" min="1.01" value="<%= params[:odds] %>"
               class="mt-1 block w-36 px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-white">
      </label>
      <button class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-sm font-medium text-white">Berechnen</button>
    <% end %>

    <% if @kelly %>
      <p class="mt-4 text-sm text-gray-300">
        Empfohlener Einsatz (¼ Kelly): <strong class="text-emerald-400"><%= @kelly[:recommended_pct] %> %</strong>
        der Bankroll – bei 1.000 € also <strong class="text-white"><%= number_to_currency(@kelly[:stake_for_1000], unit: "€", format: "%n %u") %></strong>.
      </p>
    <% elsif params[:odds].present? %>
      <p class="mt-4 text-sm text-gray-400">Bei dieser Quote gibt es keinen positiven Erwartungswert.</p>
    <% end %>
  </div>
</div>
