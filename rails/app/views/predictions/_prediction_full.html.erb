<%# Full prediction panel — shown on match#show for premium users %>
<div class="space-y-4">

  <%# 1X2 Probabilities %>
  <div class="rounded-2xl bg-gray-900 border border-gray-800 p-5">
    <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wide mb-4">Ausgangswahrscheinlichkeit (1X2)</h3>
    <div class="grid grid-cols-3 gap-3 mb-4">
      <% [["Heimsieg", prediction.home_win_prob, "emerald"], ["Unentschieden", prediction.draw_prob, "gray"], ["Auswärtssieg", prediction.away_win_prob, "blue"]].each do |label, prob, color| %>
        <div class="text-center rounded-xl p-3 bg-gray-800">
          <p class="text-2xl font-black text-<%= color %>-400"><%= (prob * 100).round %>%</p>
          <p class="text-xs text-gray-500 mt-1"><%= label %></p>
        </div>
      <% end %>
    </div>
    <div class="flex rounded-full overflow-hidden h-3">
      <div class="bg-emerald-500 transition-all" style="width:<%= (prediction.home_win_prob*100).round %>%"></div>
      <div class="bg-gray-600"  style="width:<%= (prediction.draw_prob*100).round %>%"></div>
      <div class="bg-blue-500"  style="width:<%= (prediction.away_win_prob*100).round %>%"></div>
    </div>
  </div>

  <%# Over/Under + BTTS + xG %>
  <div class="grid grid-cols-2 gap-4">

    <div class="rounded-2xl bg-gray-900 border border-gray-800 p-5">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Over / Under</h3>
      <% [["1.5"], ["2.5"], ["3.5"]].each do |line,| %>
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-300">Über <%= line %></span>
          <span class="font-bold text-emerald-400"><%= ((prediction.over_under_probs&.dig(line) || 0) * 100).round %>%</span>
        </div>
      <% end %>
      <div class="mt-2 pt-2 border-t border-gray-800 flex justify-between items-center">
        <span class="text-xs text-gray-500">Erwartete Tore</span>
        <span class="font-semibold text-white"><%= prediction.predicted_goals&.round(2) || "–" %></span>
      </div>
    </div>

    <div class="rounded-2xl bg-gray-900 border border-gray-800 p-5">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Weitere Märkte</h3>
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-300">BTTS (Beide treffen)</span>
        <span class="font-bold text-emerald-400"><%= ((prediction.btts_prob || 0) * 100).round %>%</span>
      </div>
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-300">xG Heim</span>
        <span class="font-semibold text-white"><%= prediction.xg_home&.round(2) || "–" %></span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-300">xG Auswärts</span>
        <span class="font-semibold text-white"><%= prediction.xg_away&.round(2) || "–" %></span>
      </div>
    </div>
  </div>

  <%# Value & Kelly %>
  <div class="rounded-2xl bg-gray-900 border border-gray-800 p-5">
    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-4">KI-Empfehlung</h3>
    <div class="grid grid-cols-3 gap-4">
      <div>
        <p class="text-xs text-gray-500 mb-1">Tipp</p>
        <% bet_label = {"home_win" => "Heimsieg", "away_win" => "Auswärtssieg", "draw" => "Unentschieden"} %>
        <p class="font-bold text-white text-lg"><%= bet_label[prediction.recommended_bet] || prediction.recommended_bet&.humanize || "–" %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 mb-1">Value-Rating</p>
        <p class="text-yellow-400 text-base"><%= prediction.value_stars %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500 mb-1">Kelly-Einsatz</p>
        <p class="font-bold text-emerald-400"><%= prediction.kelly_fraction ? "#{(prediction.kelly_fraction * 100).round(1)}%" : "–" %></p>
      </div>
    </div>
    <div class="mt-3 flex items-center gap-3">
      <p class="text-xs text-gray-500">Konfidenz:</p>
      <div class="flex-1 bg-gray-800 rounded-full h-2">
        <div class="bg-emerald-500 h-2 rounded-full" style="width:<%= prediction.confidence_score %>%"></div>
      </div>
      <p class="text-xs font-bold text-white"><%= prediction.confidence_score %>%</p>
    </div>
  </div>

  <%# AI Analysis text %>
  <% if prediction.ai_analysis.present? %>
    <div class="rounded-2xl bg-gray-900 border border-gray-800 p-5">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">🤖 KI-Matchanalyse</h3>
      <p class="text-sm text-gray-300 leading-relaxed whitespace-pre-line"><%= prediction.ai_analysis %></p>
      <p class="text-xs text-gray-600 mt-3">Generiert von KickAI v<%= prediction.model_version %> · <%= prediction.created_at.strftime("%d.%m.%Y %H:%M") %></p>
    </div>
  <% end %>

</div>
