<% content_for :title, @match.title %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <%# Match header %>
  <div class="rounded-2xl bg-gray-900 border border-gray-800 p-6 mb-6">
    <p class="text-sm text-gray-500 mb-3"><%= @match.league.name %> · <%= @match.scheduled_at.strftime("%d. %B %Y, %H:%M Uhr") %></p>

    <div class="flex items-center justify-center gap-6 my-4">
      <div class="text-center flex-1">
        <p class="text-2xl font-bold text-white"><%= @match.home_team.name %></p>
        <p class="text-xs text-gray-500 mt-1">Heimteam</p>
      </div>

      <% if @match.finished? %>
        <div class="text-5xl font-black text-emerald-400 px-4">
          <%= @match.result %>
        </div>
      <% else %>
        <div class="text-lg font-bold text-gray-500 px-6 py-3 bg-gray-800 rounded-xl">VS</div>
      <% end %>

      <div class="text-center flex-1">
        <p class="text-2xl font-bold text-white"><%= @match.away_team.name %></p>
        <p class="text-xs text-gray-500 mt-1">Auswärtsteam</p>
      </div>
    </div>

    <div class="flex justify-center">
      <span class="text-xs px-3 py-1 rounded-full border <%= @match.scheduled? ? "border-blue-700 text-blue-400" : "border-gray-700 text-gray-400" %>">
        <%= @match.status_label %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# Prediction panel (left 2 cols) %>
    <div class="lg:col-span-2 space-y-4">
      <% if @match.has_prediction? && current_user&.can_view_predictions? %>
        <%= render "predictions/prediction_full", prediction: @match.prediction, match: @match %>
      <% elsif !current_user&.can_view_predictions? %>
        <div class="rounded-2xl bg-gradient-to-br from-emerald-950 to-gray-900 border border-emerald-800 p-8 text-center">
          <p class="text-3xl mb-3">🔒</p>
          <h3 class="text-lg font-bold text-white mb-2">Premium erforderlich</h3>
          <p class="text-gray-400 text-sm mb-5">Schalte KI-Vorhersagen, xG-Werte, Kelly-Kalkulation und vollständige Analysen frei.</p>
          <%= link_to "Premium freischalten", pricing_path, class: "inline-block px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-white font-bold transition" %>
        </div>
      <% else %>
        <div class="rounded-2xl bg-gray-900 border border-gray-800 p-6 text-center text-gray-500">
          <p>Vorhersage wird noch generiert…</p>
          <button class="mt-3 text-sm text-emerald-400 hover:text-emerald-300"
                  data-controller="reload-after" data-reload-after-seconds-value="30">
            Automatisch aktualisieren
          </button>
        </div>
      <% end %>
    </div>

    <%# Sidebar: Form + H2H %>
    <div class="space-y-4">
      <%# Home form %>
      <div class="rounded-xl bg-gray-900 border border-gray-800 p-4">
        <h4 class="text-sm font-semibold text-gray-300 mb-3">Form: <%= @match.home_team.name %></h4>
        <div class="flex gap-1">
          <% @home_form.each do |m| %>
            <% outcome = m.home_team_id == @match.home_team_id ? (m.home_score > m.away_score ? "W" : m.home_score == m.away_score ? "D" : "L") : (m.away_score > m.home_score ? "W" : m.home_score == m.away_score ? "D" : "L") %>
            <span class="w-7 h-7 flex items-center justify-center rounded text-xs font-bold
                         <%= outcome == "W" ? "bg-emerald-700 text-emerald-200" : outcome == "D" ? "bg-gray-700 text-gray-300" : "bg-red-900 text-red-300" %>">
              <%= outcome %>
            </span>
          <% end %>
        </div>
      </div>

      <%# Away form %>
      <div class="rounded-xl bg-gray-900 border border-gray-800 p-4">
        <h4 class="text-sm font-semibold text-gray-300 mb-3">Form: <%= @match.away_team.name %></h4>
        <div class="flex gap-1">
          <% @away_form.each do |m| %>
            <% outcome = m.away_team_id == @match.away_team_id ? (m.away_score > m.home_score ? "W" : m.home_score == m.away_score ? "D" : "L") : (m.home_score > m.away_score ? "W" : m.home_score == m.away_score ? "D" : "L") %>
            <span class="w-7 h-7 flex items-center justify-center rounded text-xs font-bold
                         <%= outcome == "W" ? "bg-emerald-700 text-emerald-200" : outcome == "D" ? "bg-gray-700 text-gray-300" : "bg-red-900 text-red-300" %>">
              <%= outcome %>
            </span>
          <% end %>
        </div>
      </div>

      <%# H2H %>
      <% if @head_to_head.any? %>
        <div class="rounded-xl bg-gray-900 border border-gray-800 p-4">
          <h4 class="text-sm font-semibold text-gray-300 mb-3">Direktvergleich</h4>
          <div class="space-y-2">
            <% @head_to_head.each do |m| %>
              <div class="flex items-center justify-between text-xs">
                <span class="text-gray-400 truncate flex-1"><%= m.home_team.name %></span>
                <span class="font-bold text-white mx-2 shrink-0"><%= m.result %></span>
                <span class="text-gray-400 truncate flex-1 text-right"><%= m.away_team.name %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</div>
