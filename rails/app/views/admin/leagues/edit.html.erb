<% content_for :title, "Liga bearbeiten · Admin" %>

<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render "admin/shared/nav" %>
  <h1 class="text-2xl font-bold text-white mb-6"><%= @league.name %></h1>
  <%= render "form", league: @league %>
  <%= button_to "Liga löschen", admin_league_path(@league), method: :delete,
        form: { data: { turbo_confirm: "Liga und alle Spiele löschen?" } },
        class: "mt-6 px-4 py-2 rounded-lg bg-red-900 text-sm text-red-200" %>
</div>
