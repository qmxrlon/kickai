<% content_for :title, "Admin" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-white mb-4">Admin</h1>
  <%= render "admin/shared/nav" %>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <% [["Benutzer", @user_count], ["Premium", @premium_count], ["Spiele", @match_count], ["Vorhersagen", @prediction_count]].each do |label, value| %>
      <div class="rounded-xl bg-gray-900 border border-gray-800 p-5">
        <p class="text-xs text-gray-500 uppercase tracking-wide"><%= label %></p>
        <p class="text-3xl font-bold text-white mt-1"><%= value %></p>
      </div>
    <% end %>
  </div>

  <div class="grid lg:grid-cols-2 gap-6">
    <section class="rounded-xl bg-gray-900 border border-gray-800 p-5">
      <h2 class="font-semibold text-white mb-3">Neue Benutzer</h2>
      <ul class="divide-y divide-gray-800 text-sm">
        <% @recent_users.each do |u| %>
          <li class="py-2 flex justify-between"><%= link_to u.email, admin_user_path(u), class: "text-gray-300 hover:text-white" %><span class="text-gray-500"><%= u.role %></span></li>
        <% end %>
      </ul>
    </section>
    <section class="rounded-xl bg-gray-900 border border-gray-800 p-5">
      <h2 class="font-semibold text-white mb-3">Nächste Spiele</h2>
      <ul class="divide-y divide-gray-800 text-sm">
        <% @upcoming_matches.each do |m| %>
          <li class="py-2 flex justify-between"><%= link_to m.title, admin_match_path(m), class: "text-gray-300 hover:text-white" %><span class="text-gray-500"><%= m.scheduled_at.strftime("%d.%m. %H:%M") %></span></li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
