<% content_for :title, "Spiele · Admin" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-white mb-4">Spiele</h1>
  <%= render "admin/shared/nav" %>

  <table class="w-full text-sm">
    <thead class="text-left text-gray-500 border-b border-gray-800">
      <tr><th class="py-2">Datum</th><th>Spiel</th><th>Liga</th><th>Status</th><th>Vorhersage</th></tr>
    </thead>
    <tbody class="divide-y divide-gray-800">
      <% @matches.each do |m| %>
        <tr>
          <td class="py-2 text-gray-500"><%= m.scheduled_at.strftime("%d.%m.%Y %H:%M") %></td>
          <td><%= link_to m.title, admin_match_path(m), class: "text-gray-200 hover:text-white" %></td>
          <td class="text-gray-400"><%= m.league.name %></td>
          <td class="text-gray-400"><%= m.status_label %></td>
          <td class="<%= m.has_prediction? ? "text-emerald-400" : "text-gray-600" %>"><%= m.has_prediction? ? "✓" : "–" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="mt-4"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
</div>
