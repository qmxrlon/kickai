<% content_for :title, "Benutzer bearbeiten · Admin" %>

<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render "admin/shared/nav" %>
  <h1 class="text-2xl font-bold text-white mb-6">Benutzer bearbeiten</h1>

  <%= form_with model: [:admin, @user], class: "space-y-4" do |f| %>
    <%= render "admin/shared/errors", record: @user %>
    <div><%= f.label :name, "Name", class: "block text-sm text-gray-400 mb-1" %><%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-white" %></div>
    <div><%= f.label :email, "E-Mail", class: "block text-sm text-gray-400 mb-1" %><%= f.email_field :email, class: "w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-white" %></div>
    <div><%= f.label :role, "Rolle", class: "block text-sm text-gray-400 mb-1" %><%= f.select :role, User.roles.keys, {}, class: "w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-white" %></div>
    <%= f.submit "Speichern", class: "px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-sm font-medium text-white cursor-pointer" %>
  <% end %>
</div>
