<% content_for :title, "Benutzer · Admin" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-white mb-4">Benutzer</h1>
  <%= render "admin/shared/nav" %>

  <%= search_form_for @q, url: admin_users_path, html: { class: "mb-4 flex gap-2" } do |f| %>
    <%= f.search_field :email_or_name_cont, placeholder: "E-Mail oder Name…", class: "px-3 py-1.5 rounded-lg bg-gray-800 border border-gray-700 text-sm text-white" %>
    <%= f.submit "Suchen", class: "px-4 py-1.5 rounded-lg bg-gray-700 text-sm text-white cursor-pointer" %>
  <% end %>

  <table class="w-full text-sm">
    <thead class="text-left text-gray-500 border-b border-gray-800">
      <tr><th class="py-2">E-Mail</th><th>Name</th><th>Rolle</th><th>Registriert</th><th></th></tr>
    </thead>
    <tbody class="divide-y divide-gray-800">
      <% @users.each do |u| %>
        <tr>
          <td class="py-2"><%= link_to u.email, admin_user_path(u), class: "text-gray-200 hover:text-white" %></td>
          <td class="text-gray-400"><%= u.name %></td>
          <td class="text-gray-400"><%= u.role %></td>
          <td class="text-gray-500"><%= u.created_at.strftime("%d.%m.%Y") %></td>
          <td class="text-right"><%= link_to "Bearbeiten", edit_admin_user_path(u), class: "text-amber-400 hover:text-amber-300" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="mt-4"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
</div>
