<% content_for :title, "#{@user.email} · Admin" %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= render "admin/shared/nav" %>
  <h1 class="text-2xl font-bold text-white mb-6"><%= @user.email %></h1>

  <dl class="grid grid-cols-3 gap-y-3 text-sm rounded-xl bg-gray-900 border border-gray-800 p-5">
    <dt class="text-gray-500">Name</dt><dd class="col-span-2 text-gray-200"><%= @user.name.presence || "–" %></dd>
    <dt class="text-gray-500">Rolle</dt><dd class="col-span-2 text-gray-200"><%= @user.role %></dd>
    <dt class="text-gray-500">Abo aktiv</dt><dd class="col-span-2 text-gray-200"><%= @user.subscribed? ? "Ja" : "Nein" %></dd>
    <dt class="text-gray-500">Registriert</dt><dd class="col-span-2 text-gray-200"><%= @user.created_at.strftime("%d.%m.%Y %H:%M") %></dd>
  </dl>

  <div class="mt-6 flex gap-3">
    <%= link_to "Bearbeiten", edit_admin_user_path(@user), class: "px-4 py-2 rounded-lg bg-gray-700 text-sm text-white" %>
    <%= button_to "Löschen", admin_user_path(@user), method: :delete,
          form: { data: { turbo_confirm: "Benutzer wirklich löschen?" } },
          class: "px-4 py-2 rounded-lg bg-red-900 text-sm text-red-200" %>
  </div>
</div>
