<nav class="bg-gray-900 border-b border-gray-800 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <%# Logo %>
      <%= link_to root_path, class: "flex items-center gap-2 font-bold text-xl text-white" do %>
        <span class="text-emerald-400">⚽</span>
        <span>Kick<span class="text-emerald-400">AI</span></span>
      <% end %>

      <%# Main nav %>
      <div class="hidden md:flex items-center gap-6 text-sm font-medium">
        <%= link_to "Dashboard",  root_path,    class: "text-gray-300 hover:text-white transition #{current_page?(root_path) ? 'text-white' : ''}" %>
        <%= link_to "Spiele",     matches_path, class: "text-gray-300 hover:text-white transition" %>
        <%= link_to "Preise",     pricing_path, class: "text-gray-300 hover:text-white transition" %>
        <% if current_user&.admin? %>
          <%= link_to "Admin",    admin_root_path, class: "text-amber-400 hover:text-amber-300 transition" %>
        <% end %>
      </div>

      <%# Auth %>
      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <% if current_user.can_view_predictions? %>
            <span class="hidden sm:inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-emerald-900 text-emerald-300">
              Premium
            </span>
          <% else %>
            <%= link_to "Upgrade", pricing_path, class: "hidden sm:inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition" %>
          <% end %>

          <div class="relative" data-controller="dropdown">
            <button data-action="click->dropdown#toggle" class="flex items-center gap-2 text-sm text-gray-300 hover:text-white transition">
              <span class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center font-bold text-xs">
                <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
              </span>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-gray-800 rounded-lg shadow-xl border border-gray-700 py-1 text-sm">
              <div class="px-4 py-2 border-b border-gray-700 text-gray-400 text-xs truncate"><%= current_user.email %></div>
              <%= link_to "Einstellungen", edit_user_registration_path, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white transition" %>
              <% if current_user.subscribed? %>
                <%= link_to "Abo verwalten", portal_subscriptions_path, method: :post, class: "block px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white transition" %>
              <% end %>
              <%= link_to "Abmelden", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2 text-red-400 hover:bg-gray-700 transition" %>
            </div>
          </div>
        <% else %>
          <%= link_to "Anmelden",    new_user_session_path,     class: "text-sm text-gray-300 hover:text-white transition" %>
          <%= link_to "Registrieren", new_user_registration_path, class: "text-sm px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium transition" %>
        <% end %>
      </div>

    </div>
  </div>
</nav>
