# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=kickai
POSTGRES_PASSWORD=change_me_very_secure_password
POSTGRES_DB=kickai_production

# ─── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=production
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
# Generate with: openssl rand -hex 16  (same as what goes in config/master.key)
RAILS_MASTER_KEY=

# ─── Python API ───────────────────────────────────────────────────────────────
# Shared secret between Rails and Python service — generate with: openssl rand -hex 32
PYTHON_API_SECRET=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ─── PayPal ───────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox   # change to "live" for production

# ─── Data Sources ─────────────────────────────────────────────────────────────
# Free key from https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# ─── Network ──────────────────────────────────────────────────────────────────
HTTP_PORT=80
